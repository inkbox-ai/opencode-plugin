{
  "name": "@inkbox/opencode-plugin",
  "version": "0.2.20",
  "private": true,
  "description": "Inkbox for opencode \u2014 give your agent an email address, a phone number (SMS/MMS + voice), iMessage, dedicated WhatsApp, contacts, notes, and an encrypted credential vault.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/native-runtime.d.ts",
      "import": "./dist/native-runtime.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "REMOTE_TOOLS.md"
  ],
  "bin": {
    "inkbox-opencode": "bin/inkbox-opencode.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests scripts bin",
    "format": "biome format --write src tests scripts bin"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "inkbox",
    "email",
    "sms",
    "imessage",
    "phone",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkbox-ai/opencode-plugin.git"
  },
  "homepage": "https://inkbox.ai",
  "bugs": {
    "url": "https://github.com/inkbox-ai/opencode-plugin/issues"
  },
  "engines": {
    "opencode": ">=1.17.18 <2.0.0 || >=2.0.26 <2.1.0"
  },
  "dependencies": {
    "@inkbox/sdk": ">=0.7.38 <1.0.0",
    "@opencode-ai/sdk": ">=1.17.18 <1.19.0",
    "@opencode/client": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "jsonc-parser": "3.3.1",
    "ws": "^8.21.0",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@opencode-ai/plugin": "1.17.18",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "@inkbox/sdk": "github:inkbox-ai/inkbox#5ebde74b33bd560e9c9818f675ff0c5c6f1cb962&path:/sdk/typescript"
    }
  }
}
